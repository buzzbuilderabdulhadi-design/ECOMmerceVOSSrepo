# ============================================================
# VOSS — Root .gitignore
# ============================================================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/.next/
client/out/
server/dist/

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Uploads (local development)
uploads/
server/src/uploads/

# Misc
*.pem
.cache/
.tmp/

