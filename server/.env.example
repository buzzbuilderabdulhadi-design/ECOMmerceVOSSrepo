# Server Environment Variables
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/voss_ecommerce?retryWrites=true&w=majority

# JWT — Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Access and refresh tokens MUST use DIFFERENT secrets.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin Bootstrap Credentials (used by prisma seed only, never committed with real values)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# Client URL (for CORS). Production must be an https:// origin.
CLIENT_URL=http://localhost:3000

# Extra browser origins allowed to make credentialed requests (comma-separated).
# CLIENT_URL is always allowed. Production entries must use https://.
# ALLOWED_ORIGINS=https://www.example.com

# Cookie/session options
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Cloudinary
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_PUBLIC_MAX=1000
# Shared counter store. REQUIRED in production so every app instance enforces
# the same limits. Use a private/authenticated Redis (rediss:// when remote).
REDIS_URL=redis://localhost:6379
# Only for a deliberate single-instance production deployment. Without Redis
# and without this opt-in, startup fails rather than silently using
# per-process counters.
# RATE_LIMIT_ALLOW_MEMORY=false
# RATE_LIMIT_KEY_PREFIX=voss:rl:
# REDIS_CONNECT_TIMEOUT_MS=5000

# Email (SMTP)
EMAIL_SERVICE=your_email_service
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# PayPal (Orders v2 REST API). sandbox credentials for PAYPAL_ENVIRONMENT=sandbox.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_for_signature_verification

# Direct Bank Transfer (manual/offline payment)
# Enabled only when BANK_TRANSFER_ENABLED=true and BANK_NAME + BANK_IBAN are set.
BANK_TRANSFER_ENABLED=false
BANK_NAME=your_bank_name
BANK_ACCOUNT_TITLE=your_account_title
BANK_IBAN=your_iban
BANK_ACCOUNT_NUMBER=your_account_number
BANK_SWIFT_CODE=your_swift_bic
BANK_BRANCH=your_branch
BANK_TRANSFER_INSTRUCTIONS=Optional custom instructions shown to the customer

# Payoneer (manual/external payment)
# NOTE: Payoneer DOES publish an official ecommerce checkout API ("Payoneer
# Checkout", formerly Optile: embedded SDK + hosted page + POST /lists payment
# session), but it is gated — early-access signups, requires a US/HK legal
# entity and ~USD 20k+/mo webstore volume, and is processed by Stripe in some
# jurisdictions. It is not available to this store, so Payoneer is implemented
# as a manual/external method: customers send payment out-of-band via their
# Payoneer account and an admin verifies it. Only the receiving account email
# is used (never a secret); official checkout credentials are intentionally
# not consumed by this project.
# Enabled when PAYONEER_ENABLED != false AND PAYONEER_ACCOUNT_EMAIL is set.
PAYONEER_ENABLED=false
PAYONEER_ACCOUNT_EMAIL=your_payoneer_account_email
PAYONEER_INSTRUCTIONS=Optional custom instructions shown to the customer

# Google OAuth (Continue with Google) - OpenID Connect authorization-code flow
# Register an OAuth 2.0 Client ID ("Web application") in the Google Cloud
# console, then set the Authorized redirect URI below in the console to match
# GOOGLE_REDIRECT_URI exactly (production must be https).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
